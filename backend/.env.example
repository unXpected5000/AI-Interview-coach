APP_NAME=AI Interview Coach API
APP_ENV=development
API_PREFIX=/api
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=ai_interview_coach

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
GOOGLE_CLIENT_ID=

# Optional provider for question generation, adaptation, and written feedback.
LLM_PROVIDER=gemini
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-3.1-flash-lite
LLM_TIMEOUT_SECONDS=30

MAX_RESUME_UPLOAD_MB=10
MAX_RESUME_PDF_PAGES=40

# Email verification (required before password accounts can sign in).
# Placeholders only; put real values in your local .env or host secrets.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
# Development only (APP_ENV=development): log codes to the API console instead
# of sending email. Ignored in any other environment.
EMAIL_DEV_LOG_CODES=false
EMAIL_VERIFICATION_CODE_TTL_MINUTES=15
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_SENDS_PER_HOUR=5

# Roles. Comma-separated email addresses that become operators after they sign
# in with a verified email. Leave empty until you choose the operator account.
OPERATOR_EMAILS=
DEPARTMENTS=Computer Science,Information Technology,Electronics and Communication,Electrical,Mechanical,Civil
MAX_STUDY_YEAR=5

# In-memory rate limits (single process; reset on restart). Set a client IP
# header only if the API is reachable exclusively through a proxy that sets it.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_KEYS=20000
RATE_LIMIT_CLIENT_IP_HEADER=

# Coaching readiness categories (score boundaries on a 0–100 scale)
READINESS_DEVELOPING_THRESHOLD=20
READINESS_MODERATE_THRESHOLD=40
READINESS_GOOD_PROGRESS_THRESHOLD=60
READINESS_STRONG_THRESHOLD=80
