# Public Google Identity Services web client ID; never put a client secret here.
VITE_GOOGLE_CLIENT_ID=

# Optional when the API is not proxied through the frontend host.
# VITE_API_BASE_URL=http://localhost:8000/api

# Operator details shown in the Privacy Policy and Terms (public, build-time).
# Leave blank until decided; the pages show a visible "not configured" marker.
VITE_LEGAL_OPERATOR_NAME=
VITE_LEGAL_CONTACT_EMAIL=
VITE_LEGAL_POSTAL_ADDRESS=
VITE_LEGAL_GOVERNING_LAW=
VITE_LEGAL_MINIMUM_AGE=
VITE_LEGAL_INSTITUTION=
